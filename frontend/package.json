{
  "name": "erplancers-erp-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:crm": "vite build --config apps/crm/vite.config.ts",
    "build:sales": "vite build --config apps/sales/vite.config.ts",
    "build:inventory": "vite build --config apps/inventory/vite.config.ts",
    "build:finance": "vite build --config apps/finance/vite.config.ts",
    "build:accounting": "vite build --config apps/accounting/vite.config.ts",
    "build:procurement": "vite build --config apps/procurement/vite.config.ts",
    "build:bi": "vite build --config apps/bi/vite.config.ts",
    "build:modules": "npm run build:crm && npm run build:sales && npm run build:inventory && npm run build:finance && npm run build:accounting && npm run build:procurement && npm run build:bi"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.2",
    "chart.js": "^4.5.0",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "recharts": "^3.2.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
